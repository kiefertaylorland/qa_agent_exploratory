# "mock" for deterministic evals (default in evals), or a Vercel AI Gateway model id
# e.g. anthropic/claude-sonnet-5
QA_AGENT_MODEL=mock

# Written to .env.local by `eve link` after `vercel login` — do not set by hand
AI_GATEWAY_API_KEY=

# Optional fixed port for `pnpm demo-target`; 0 (default) picks a free port and prints it
DEMO_TARGET_PORT=0
